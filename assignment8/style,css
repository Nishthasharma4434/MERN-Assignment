/* ---------- BASIC STYLING ---------- */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: #eaf2f5;
    color: #203c4c;
    line-height: 1.5;
}

.container {
    width: 95%;
    max-width: 1200px;
    margin: auto;
    padding: 30px 0;
}

.page-header {
    margin-bottom: 30px;
}

.breadcrumb {
    color: #267b79;
    font-size: 12px;
    font-weight: bold;
    margin-bottom: 8px;
}

.page-header h1 {
    font-size: 32px;
    margin-bottom: 5px;
}

.subtitle {
    font-size: 14px;
    color: #647783;
}

/* ---------- PREVIEW SECTION ---------- */

.preview-section {
    display: grid;
    grid-template-columns: 2fr 1.4fr 1fr;
    gap: 22px;
    align-items: start;
    margin-bottom: 70px;
}

.preview {
    min-width: 0;
}

.preview > h3 {
    color: #267b79;
    font-size: 15px;
    margin-bottom: 12px;
}

.cafe {
    background-color: white;
    overflow: hidden;
    border: 1px solid #cbd8d8;
}

/* ---------- NAVIGATION BAR ---------- */

.navbar {
    background-color: #004b4c;
    color: white;
    padding: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
}

.navbar strong {
    font-size: 12px;
    white-space: nowrap;
}

.navbar nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.navbar a,
.cafe-footer a {
    color: white;
    text-decoration: none;
    font-size: 10px;
}

/* ---------- HERO SECTION ---------- */

.hero {
    background-color: #075c4b;
    color: white;
    padding: 25px 20px;
}

.hero small {
    font-size: 10px;
    font-weight: bold;
    color: #c9e1ca;
}

.hero h2 {
    font-size: 26px;
    line-height: 1.25;
    margin: 12px 0 5px;
}

.hero p {
    font-size: 13px;
    margin-bottom: 12px;
}

.visit-btn {
    display: inline-block;
    background-color: #008b80;
    color: white;
    text-decoration: none;
    padding: 9px 20px;
    border-radius: 5px;
    font-size: 12px;
}

/* ---------- FAVOURITE CARDS ---------- */

.content {
    padding: 18px;
}

.content > h3 {
    font-size: 17px;
    margin-bottom: 10px;
}

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
}

.card {
    background-color: #f3f8f7;
    border: 1px solid #cbd8d8;
    border-radius: 5px;
    padding: 12px;
    min-width: 0;
}

.card:nth-child(2) {
    border: 2px solid #d5b56b;
}

.card h4 {
    font-size: 13px;
    margin-bottom: 5px;
}

.card p {
    font-size: 11px;
}

/* ---------- LANDSCAPE IMAGE ---------- */

.landscape {
    height: 85px;
    margin-top: 15px;
    border-radius: 4px;
    background:
        radial-gradient(ellipse at 78% 15%, #fff2b8 0 5%, transparent 6%),
        linear-gradient(145deg, transparent 48%, #75a99b 49% 68%, transparent 69%),
        linear-gradient(35deg, transparent 43%, #28746c 44% 70%, transparent 71%),
        #d7e9dc;
}

.caption {
    font-size: 11px;
    margin-top: 8px;
    font-style: italic;
}

.address {
    font-size: 11px;
    margin-top: 10px;
}

/* ---------- FOOTER ---------- */

.cafe-footer {
    background-color: #004b4c;
    color: white;
    padding: 12px;
}

.cafe-footer strong {
    display: block;
    font-size: 12px;
    margin-bottom: 5px;
}

.cafe-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

/* ---------- AUDIT SECTION ---------- */

.audit-section {
    background-color: white;
    padding: 25px;
    border: 1px solid #d0dddd;
    border-radius: 10px;
    margin-bottom: 80px;
}

.audit-section h3 {
    font-size: 17px;
    margin-bottom: 18px;
}

.comparison {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px;
    margin-bottom: 25px;
}

.comparison h4 {
    font-size: 14px;
    margin-bottom: 12px;
}

.bad-menu,
.good-menu {
    padding: 15px;
    border-radius: 7px;
    font-size: 13px;
    white-space: nowrap;
}

.bad-menu {
    background-color: #f9dddd;
    color: #934d4d;
    overflow: hidden;
}

.good-menu {
    background-color: #e0f0e7;
    color: #315f4d;
    white-space: normal;
}

.report-title {
    color: #267b79;
    margin-top: 20px;
}

.report-list {
    list-style: none;
}

.report-list li {
    font-size: 13px;
    margin-bottom: 12px;
}

/* ---------- NOTE SECTION ---------- */

.note {
    background-color: #dceff0;
    border: 1px solid #c9dddd;
    border-radius: 8px;
    padding: 15px;
    font-size: 13px;
    margin-bottom: 25px;
}

.bottom-note {
    font-size: 12px;
    color: #71818a;
    text-align: center;
}

/* =================================================
   TABLET RESPONSIVE DESIGN - 768px
================================================= */

@media screen and (max-width: 768px) {

    .container {
        width: 94%;
    }

    .preview-section {
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    /* Mobile preview moves to next row */
    .preview.mobile {
        grid-column: 1 / -1;
        max-width: 375px;
        width: 100%;
        justify-self: center;
    }

    .navbar {
        padding: 10px;
    }

    .hero {
        padding: 20px 15px;
    }

    .hero h2 {
        font-size: 22px;
    }

    .cards {
        gap: 7px;
    }

    .card {
        padding: 9px;
    }

    .comparison {
        gap: 15px;
    }

    .audit-section {
        padding: 18px;
    }
}

/* =================================================
   MOBILE RESPONSIVE DESIGN - 480px
================================================= */

@media screen and (max-width: 480px) {

    body {
        font-size: 14px;
    }

    .container {
        width: 94%;
        padding-top: 20px;
    }

    .page-header h1 {
        font-size: 25px;
    }

    .subtitle {
        font-size: 12px;
    }

    /* All previews stack vertically */
    .preview-section {
        grid-template-columns: 1fr;
        gap: 25px;
    }

    .preview.mobile {
        grid-column: auto;
        max-width: 100%;
    }

    .preview > h3 {
        font-size: 14px;
    }

    .navbar {
        flex-direction: column;
        align-items: flex-start;
        padding: 12px;
    }

    .navbar nav {
        width: 100%;
        gap: 12px;
        flex-wrap: wrap;
    }

    .navbar a {
        font-size: 12px;
    }

    .hero {
        padding: 22px 15px;
    }

    .hero h2 {
        font-size: 22px;
    }

    .hero p {
        font-size: 13px;
    }

    .visit-btn {
        padding: 12px 20px;
        margin-top: 5px;
    }

    /* Cards become vertical */
    .cards {
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .card {
        padding: 14px;
    }

    .card h4 {
        font-size: 15px;
    }

    .card p {
        font-size: 13px;
    }

    .landscape {
        height: 110px;
    }

    .caption,
    .address {
        font-size: 12px;
    }

    .cafe-footer {
        padding: 14px;
    }

    .cafe-footer nav {
        gap: 12px;
    }

    .cafe-footer a {
        font-size: 12px;
    }

    /* Before and after stack vertically */
    .comparison {
        grid-template-columns: 1fr;
    }

    .bad-menu,
    .good-menu {
        white-space: normal;
        overflow-wrap: anywhere;
        padding: 12px;
    }

    .audit-section {
        padding: 15px;
        margin-bottom: 35px;
    }

    .audit-section h3 {
        font-size: 15px;
    }

    .report-list li {
        font-size: 12px;
        line-height: 1.6;
    }

    .note {
        font-size: 12px;
    }
}

/* ---------- IMAGE RESPONSIVENESS ---------- */

img {
    max-width: 100%;
    height: auto;
    display: block;
}